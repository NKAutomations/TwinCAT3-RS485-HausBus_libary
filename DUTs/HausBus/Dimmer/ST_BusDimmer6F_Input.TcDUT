<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_BusDimmer6F_Input" Id="{2c757d27-172b-45af-b279-23a0fee5aba0}">
    <Declaration><![CDATA[TYPE ST_BusDimmer6F_Input :
STRUCT
	diID		:DINT;							(* Device ID ( Steht auf dem Aufkleber und wird zur Identifizierung im BUS benötigt)*)
	sName		:STRING;						(* Name des Tasters (zb- Wohnzimmer1 *)
	iLED      	:ARRAY[1..6] OF INT;     	  	(* gewünschter LED-Zustand (TRUE = 100 %)*)
	iDimmspeed	:INT :=10;						(* Dimmerrampe für alle Kanäle  *)
	bWriteCfg	:BOOL := FALSE;					(* Config write ausführen  *)
	bReset		:BOOL;							(* Reset des Tasters (Hardware) *)
	bExecute	:BOOL;							(* Aktivierung des Tasters *)
	bExtInputs	:BOOL := FALSE;					(* Aktiviert die Externen Inputs *)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>