<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_BusTempSensor4F_Input" Id="{bf1e9c23-9dc2-417c-bd76-7d66b49d1cb7}">
    <Declaration><![CDATA[TYPE ST_BusTempSensor4F_Input :
STRUCT
	diID		:DINT;							(* Device ID ( Steht auf dem Aufkleber und wird zur Identifizierung im BUS benötigt)*)
	sName		:STRING;						(* Name des Tasters (zb- Wohnzimmer1 *)
	bReset		:BOOL;							(* Reset des ESP32 (Hardware) *)
	bExecute	:BOOL;							(* Aktivierung des Sensors *)
	
	iAnzTempSens :INT := 4;						(* Anzahl der Tempsensoren *)
	bExtInputs	:BOOL := FALSE;					(* Aktiviert die Externen Inputs *)
	
	bWifi			:BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>