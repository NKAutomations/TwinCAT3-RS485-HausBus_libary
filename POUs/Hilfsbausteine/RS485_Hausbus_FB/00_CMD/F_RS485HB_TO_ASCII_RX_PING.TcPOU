\\=============================================================================//
F_RS485HB_TO_ASCII_RX_PING:	Sonderfunktion um Hausbus Ascii Strings zu generieren speziell für Suchstring		*)
(*
Date          	| Version    	| created under        	| Author          	| Remark *)
(*====================================================================================================================================================*)
(*22/01/2026   	| 1.00      	| TC3		  			| N.Kersting        | first release *)
(*====================================================================================================================================================*)
FUNCTION F_RS485HB_TO_ASCII_RX_PING : STRING(255)
VAR_INPUT
	I_diID				:DINT;				(* Device ID ( Steht auf dem Aufkleber und wird zur Identifizierung im BUS benötigt)*)	
END_VAR
VAR
	sStartZeichen		:BYTE := 16#FD;				(* Startzeichen Präfix *)
	sEndZeichen			:BYTE := 16#FE;				(* Endzeichen Suffix *)
	Q_sOut				:STRING[255);
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF I_diID > 0
THEN
	Q_sOut :=	CONCAT(F_ToCHR(sStartZeichen),DINT_TO_STRING(I_diID));
END_IF

F_RS485HB_TO_ASCII_RX_PING:=Q_sOut;
RETURN;


]]></ST>
    </Implementation>
    <LineIds Name="F_RS485HB_TO_ASCII_RX_PING">
      <LineId Id="244" Count="2" />
