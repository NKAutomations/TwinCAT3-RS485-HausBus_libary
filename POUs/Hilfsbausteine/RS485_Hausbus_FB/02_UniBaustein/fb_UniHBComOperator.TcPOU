<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="fb_UniHBComOperator" Id="{29443f75-d93e-4068-b64d-59ad0412c1d3}" SpecialFunc="None">
    <Declaration><![CDATA[(*======================================================================================================================================*)
(*//=============================================================================\\
||  _   _ _  __  _         _                        _   _                      ||
|| | \ | | |/ / / \  _   _| |_ ___  _ __ ___   __ _| |_(_) ___  _ __         ||
|| |  \| | ' / / _ \| | | | __/ _ \| '_ ` _ \ / _` | __| |/ _ \| '_ \        ||
|| | |\  | . \/ ___ \ |_| | || (_) | | | | | | (_| | |_| | (_) | | | |       ||
|| |_| \_|_|\_\_/  \_\__,_|\__\___/|_| |_| |_|\__,_|\__|_|\___/|_| |_|       ||
||                                                                             ||
\\=============================================================================//
fb_UniHBComOperator:		Soll ein neuer einfacher Universalbaustein für die Hausbus Kommunikation werden,
							er soll die Kommunikation innerhalb der Device Bausteine Standartisieren, sodass künftige änderungen
							einfach an allen Devices gleich erfolgen und nicht überall alles angepasst werden muss!	
						 *)
(*
Date          	| Version    	| created under        	| Author          	| Remark *)
(*====================================================================================================================================================*)
(*28/08/2025   	| 1.00      		| TC3		  		| N.Kersting       	| first release *)
(*28/08/2025   	| 1.01      		| TC3		  		| N.Kersting       	| Erster Test erfogreich *)
(*05/09/2025   	| 1.02      		| TC3		  		| N.Kersting       	| Implementierung eines Change Counters, Zählt Startups hoch/ Startup Afterreset ansteuerung geändert *)
(*13/09/2025   	| 1.03      		| TC3		  		| N.Kersting       	| Doku hinzugefügt *)
(*10/01/2026   	| 1.04      		| TC3		  		| N.Kersting       	| Check Ping Eingang hinzugefügt um das Ping prüfen auszuschalten *)
(*====================================================================================================================================================*)
FUNCTION_BLOCK fb_UniHBComOperator
VAR_INPUT
	I_stIdent			:ST_HausBus_Ident;		(* HausBus Ident Struktur *)
		
	I_bExtInputs		:BOOL := FALSE;			(* Benutzung der Externen Inputs Aktivieren *)
	I_bExecute			:BOOL;					(* Aktivierung der Operation des Geräts *)
	I_bPing				:BOOL;					(* Ping eingang *)
	I_bPingCheck		:BOOL := TRUE;			(* wenn aus, wird kein Ping verwendet *)
	I_bEventStartupDone	:BOOL;					(* Rückmeldung von den Eventbausteinen	*)
	I_bResetSendDone	:BOOL;					(* Rückmeldung vom Fifo, Reset befehl ausgeführt *)
	I_bStartupDone 		:BOOL;					(* Rückmeldung vom Device, Startup ausgeführt *)		
		
	I_tPingTimeout		:TIME := T#15S;			(* Zeit Parameter für Timeout Ping *)
	I_tStartupAfterReset :TIME := T#5S;			
	I_tReboot			:TIME := T#10S;			(* Verzögerungszeit nach dem Reset ausgeführt wurde *)	
	
END_VAR
VAR_OUTPUT
	Q_EState			:E_EnumHBDeviceOPMode;
	Q_bResetEvents		:BOOL;					(* Reset Events Startup *)
	Q_bExecuteEvents	:BOOL;					(* Events Startup Starten *)
	Q_bSendResetCmd		:BOOL;					(* Sende Reset zum Gerät *)
	Q_bStartupStart		:BOOL;					(* Startup Starten *)
	Q_bActivateSend		:BOOL;					(* Aktiviere Sendefunktion *)
	Q_bOP				:BOOL;					(* Gerät im OP Mode *)
	Q_bCom				:BOOL;					(* Verbindung zum Gerät aufgebaut *)
	Q_bError			:BOOL;					(* Gerät im Fehlerzustand *)
	Q_sState			:STRING;
	Q_dwChanges			:DWORD;
END_VAR
VAR
	(*================================================================*)
	(*	Funktionsbausteine *)
	(*================================================================*)
	fbPing				:fb_RS485PingCheck;
	r_trigStartupAfterReset	:r_trig;
	tonStartupAfterReset	:ton;
	tonResetDone			:ton;
	
	(*================================================================*)
	(*	Int Variablen *)
	(*================================================================*)
	i					:INT;
	dwChanges			:DWORD :=0;
	(*================================================================*)
	(*	String Variablen *)
	(*================================================================*)
	sDeviceStartup		:STRING;
	
	(*================================================================*)
	(*	Bool Variablen *)
	(*================================================================*)
	bResetEvents		:BOOL := FALSE;
	bExecuteEvents		:BOOL := FALSE;
	bSendResetCmd		:BOOL := FALSE;
	bStartupStart		:BOOL := FALSE;
	bStartUpCheckPing	:BOOL := FALSE;
	bPingOK				:BOOL := FALSE;
	bActivateSend		:BOOL := FALSE;
	bError				:BOOL := FALSE;
	(*================================================================*)
	(*	Enums  *)
	(*================================================================*)
	EnumHBDeviceOPMode	:E_EnumHBDeviceOPMode;
	
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*///////////////////////////////////////////////////////////*)
(* Startup Zurücksetzen Reset *)

(* Startup Automatisch Zurücksetzen bei Busverlust *)
tonStartupAfterReset(
	IN := NOT bPingOK
			AND bStartUpCheckPing
			AND NOT (EnumHBDeviceOPMode=E_HB_Device_WaitCom)
			AND NOT (EnumHBDeviceOPMode=E_HB_Device_Reset),	(* Neu, damit nicht immer wieder neugestartet wird -> Bootschleife verhindern*)
	PT:= I_tStartupAfterReset);

r_trigStartupAfterReset
	(CLK := tonStartupAfterReset.Q);
	
IF NOT I_bExecute
	OR r_trigStartupAfterReset.Q
THEN
	EnumHBDeviceOPMode := E_HB_Device_Init;
END_IF

tonResetDone(
	PT:= I_tReboot);
	
(*///////////////////////////////////////////////////////////*)
(* Reset Changes *)
IF NOT I_bExecute
	OR bResetChangesCounter_All
THEN
	dwChanges := 0;
END_IF

(*///////////////////////////////////////////////////////////*)
(*	Ping Dauerhaft Prüfen *)
fbPing(
	I_bPing:= 				I_bPing, 
	I_bExecute:= 			bStartUpCheckPing, 
	I_bAutoPing:= 			TRUE, 
	I_bAutoReset:= 			TRUE, 
	I_bReset:= 				NOT bStartUpCheckPing,  
	I_tPingTimeout:= 		I_tPingTimeout);

bPingOK := 	fbPing.Q_bComOk
			OR NOT I_bPingCheck;
(*///////////////////////////////////////////////////////////*)
(*	Device States *)
CASE EnumHBDeviceOPMode OF
(*///////////////////////////////////////////////////////////*)
E_HB_Device_Init:	

	sDeviceStartup := 'INIT';
	bResetEvents := TRUE;
	bExecuteEvents := FALSE;
	bSendResetCmd := FALSE;
	bStartupStart := FALSE;
	bStartUpCheckPing := FALSE;
	bActivateSend := FALSE;
	tonResetDone.IN := FALSE;
	
	IF I_bExecute
	THEN
		EnumHBDeviceOPMode := E_HB_Device_CheckID;
	END_IF

(*///////////////////////////////////////////////////////////*)	
E_HB_Device_CheckID:
	
	sDeviceStartup := 'Device ID Prüfen';
	
	IF I_stIdent.diID <> 0
	THEN
		IF NOT I_bEventStartupDone
		THEN
			EnumHBDeviceOPMode :=	E_HB_Device_EventStartup;
		END_IF
	ELSE
		sDeviceStartup := 'ERROR- Device ID Prüfen';
	END_IF
	
(*///////////////////////////////////////////////////////////*)	
E_HB_Device_EventStartup:
		
	sDeviceStartup := 'Startup Events';	
	bResetEvents := FALSE;
	bExecuteEvents := TRUE;	(* Muss immer an bleiben *)
	bStartUpCheckPing := TRUE;
	
	IF I_bEventStartupDone
	THEN
		sDeviceStartup := 'Startup Events- warte auf Reset False Flanke';	
		IF NOT I_bResetSendDone
		THEN
			EnumHBDeviceOPMode :=	E_HB_Device_Reset;
		END_IF
	END_IF
		
(*///////////////////////////////////////////////////////////*)	
E_HB_Device_Reset:
	
	sDeviceStartup := 'Reset Ausführen';	
	bActivateSend := TRUE;
	bSendResetCmd := TRUE;
	
	IF I_bResetSendDone
	THEN
		bSendResetCmd := FALSE;
		IF NOT I_bStartupDone
		THEN
			sDeviceStartup := 'Reset Ausgeführt- warte auf Startup False Flanke';
			EnumHBDeviceOPMode :=	E_HB_Device_WaitCom;
		END_IF
	END_IF
	
(*///////////////////////////////////////////////////////////*)	
E_HB_Device_WaitCom:

	sDeviceStartup := 'Warte auf Com';	
	tonResetDone.IN := TRUE;
	
	IF tonResetDone.Q
	THEN
		IF bPingOK
		THEN
			EnumHBDeviceOPMode :=	E_HB_Device_Startup;
		END_IF
	END_IF
	
(*///////////////////////////////////////////////////////////*)	
E_HB_Device_Startup:
	
	sDeviceStartup := 'Startup Ausführen';	
	bStartupStart := TRUE;
	
	IF I_bStartupDone
	THEN
		dwChanges := dwChanges +1;
		EnumHBDeviceOPMode :=	E_HB_Device_OP;
	END_IF
	
E_HB_Device_OP:
	sDeviceStartup := 'Gerät im OP Mode';	
	bStartupStart := FALSE;
END_CASE

(*///////////////////////////////////////////////////////////*)	
bError :=	(fbPing.Q_bTimeout 
			AND I_bPingCheck)
			AND I_stIdent.diID <> 0;
			
(*///////////////////////////////////////////////////////////*)	
(* Outputs *)
Q_EState 			:=	EnumHBDeviceOPMode;
Q_bResetEvents 		:=	bResetEvents;
Q_bExecuteEvents	:=	bExecuteEvents;
Q_bSendResetCmd		:=	bSendResetCmd;
Q_bStartupStart		:=	bStartupStart;
Q_bActivateSend		:=	bActivateSend;
Q_bCom				:=	bPingOK;
Q_bError			:=	bError;
Q_bOP				:=	(EnumHBDeviceOPMode =E_HB_Device_OP);
Q_sState			:=	sDeviceStartup;
Q_dwChanges			:=	dwChanges;]]></ST>
    </Implementation>
    <Action Name="ac99_Doku" Id="{a29e5613-d3fc-479d-9b91-b76fd5bbf16f}">
      <Implementation>
        <ST><![CDATA[(*=====================================================================*)
(*  Baustein: fb_UniHBComOperator                                      *)
(*  Zweck: Standardisiert den Lebenszyklus eines HausBus-Gerätes.      *)
(*  Fokus: Einheitliche Startup-/Reset-/Com- und Ping-Logik.           *)
(*---------------------------------------------------------------------*)
(*  Hauptablauf (Zustandsmaschine E_EnumHBDeviceOPMode):               *)
(*    1) E_HB_Device_Init         : Grundzustand, wartet auf Execute.  *)
(*    2) E_HB_Device_CheckID      : Prüft I_stIdent.diID <> 0.         *)
(*    3) E_HB_Device_EventStartup : Start-Events laufen (Events an).   *)
(*    4) E_HB_Device_Reset        : Reset-Kommando senden.             *)
(*    5) E_HB_Device_WaitCom      : Reboot-Zeit + Ping abwarten.       *)
(*    6) E_HB_Device_Startup      : Gerätestart (Device-spezifisch).   *)
(*    7) E_HB_Device_OP           : Gerät im Betriebsmodus.            *)
(*---------------------------------------------------------------------*)
(*  Übergänge (vereinfacht):                                           *)
(*    Init -> CheckID bei I_bExecute=TRUE                              *)
(*    CheckID -> EventStartup wenn ID gültig und Events nicht fertig   *)
(*    EventStartup -> Reset nach I_bEventStartupDone                   *)
(*    Reset -> WaitCom nach I_bResetSendDone                          *)
(*    WaitCom -> Startup nach Rebootzeit & Ping OK                     *)
(*    Startup -> OP bei I_bStartupDone                                 *)
(*    Kommunikationsverlust nach OP/Event/Startup -> Timeout -> Init   *)
(*---------------------------------------------------------------------*)
(*  Ping-/Com-Überwachung:                                             *)
(*    fb_RS485PingCheck läuft mit AutoPing + AutoReset.                *)
(*    bPingOK = Q_bCom; Timeout liefert Fehlerflag.                    *)
(*    tonStartupAfterReset triggert Rücksprung Init bei Pingverlust,   *)
(*    jedoch nicht während RESET / WAITCOM (verhindert Schleifen).     *)
(*---------------------------------------------------------------------*)
(*  Wichtige Eingänge:                                                 *)
(*    I_bExecute          : Gesamtablauf aktiv/inaktiv.                *)
(*    I_bPing             : Eingang für Ping-Auswertung.               *)
(*    I_bEventStartupDone : Events abgeschlossen.                      *)
(*    I_bResetSendDone    : Resetbefehl ausgeführt.                    *)
(*    I_bStartupDone      : Gerätestart fertig.                        *)
(*    Zeitparameter: I_tPingTimeout / I_tStartupAfterReset / I_tReboot *)
(*---------------------------------------------------------------------*)
(*  Wichtige Ausgänge:                                                 *)
(*    Q_EState        : Aktueller Enum-Zustand.                        *)
(*    Q_bResetEvents  : Events zurücksetzen (nur INIT).                *)
(*    Q_bExecuteEvents: Events aktiv halten (Startup-Phase).           *)
(*    Q_bSendResetCmd : Reset-Befehl senden (Puls in RESET).           *)
(*    Q_bStartupStart : Startsignal Gerätestart.                       *)
(*    Q_bActivateSend : Senden erlaubt (während RESET).                *)
(*    Q_bCom          : Kommunikation/Ping OK.                         *)
(*    Q_bOP           : Gerät im OP Mode.                              *)
(*    Q_bError        : Ping Timeout bei gültiger ID.                  *)
(*    Q_sState        : Textstatus für Diagnose.                       *)
(*    Q_dwChanges     : Zählt erfolgreiche Übergänge nach OP (Startup).*)
(*---------------------------------------------------------------------*)
(*  Change Counter:                                                    *)
(*    Erhöht bei Übergang Startup -> OP.                               *)
(*    Rücksetzung bei I_bExecute=FALSE.                                *)
(*---------------------------------------------------------------------*)
(*  Fehlerlogik:                                                       *)
(*    Q_bError = (Ping Timeout) AND (ID gültig).                       *)
(*    Ungültige ID nur im Text erkennbar (kein separates Flag).        *)
(*---------------------------------------------------------------------*)
(*  Robustheit:                                                        *)
(*    Schutz vor Reset-/Boot-Schleife durch Zustandseinschränkung      *)
(*    beim Auto-Restart (kein Trigger in RESET/WAITCOM).               *)
(*---------------------------------------------------------------------*)
(*  Erweiterungspotenzial (optional):                                  *)
(*    - Separater Fehlerzustand für ID=0.                              *)
(*    - Differenziertere Fehlercodes.                                  *)
(*    - Überlaufabsicherung Q_dwChanges.                               *)
(*    - Nutzung von I_bExtInputs (aktuell ungenutzt).                  *)
(*---------------------------------------------------------------------*)
(*  Einbindung (Kurz):                                                 *)
(*    1) Baustein mit Ident + Rückmeldeflags + Ping versorgen.         *)
(*    2) Auf Q_bSendResetCmd und Q_bStartupStart reagieren.            *)
(*    3) Betriebszustand über Q_EState / Q_bOP / Q_sState auswerten.   *)
(*---------------------------------------------------------------------*)
(*  Ziel: Einheitliche, wiederverwendbare Kommunikations- und          *)
(*  Startlogik für HausBus-Geräte mit minimalem Integrationsaufwand.  *)
(*=====================================================================*)]]></ST>
      </Implementation>
    </Action>
